PORT=5000
TZ=Asia/Jakarta

# ==========================================
# 1. PENGATURAN LOCAL (WINDOWS / PC)
# ==========================================
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_NAME=copytrading

# ==========================================
# 2. PENGATURAN SERVER VPS (DOCKER / PRODUKSI)
# ==========================================
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_vps_db_password_here
# DB_NAME=copytrading
#
# Atau format DATABASE_URL:
# DATABASE_URL=postgresql://postgres:your_vps_db_password_here@postgres:5432/copytrading
