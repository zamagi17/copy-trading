# DB_PORT=5432
# DB_USER=zamagi
# DB_PASSWORD=your_db_password_here
# DB_NAME=copytrading
#
# Atau format DATABASE_URL:
# DATABASE_URL=postgresql://zamagi:your_db_password_here@zamagi_postgres:5432/copytrading
